#!/bin/sh
set -e

# TODO: implement debconf support that is maintainable without duplicating the config
#. /usr/share/debconf/confmodule

TUWUNEL_DATABASE_PATH=/var/lib/tuwunel
TUWUNEL_CONFIG_PATH=/etc/tuwunel

case "$1" in
  configure)
    # Create the `tuwunel` user if it does not exist yet.
    if ! getent passwd tuwunel > /dev/null ; then
      echo 'Adding system user for the tuwunel Matrix homeserver' 1>&2
      adduser --system --group --quiet \
        --home "$TUWUNEL_DATABASE_PATH" \
        --disabled-login \
        --shell "/usr/sbin/nologin" \
        tuwunel
    fi

    # Create the database path if it does not exist yet.
    mkdir -v -p "$TUWUNEL_DATABASE_PATH"

    # Never adopt or reshape another homeserver's data while it could still
    # be writing; the adoption below runs again on the next upgrade or on
    # dpkg-reconfigure once the old unit is stopped.
    legacy_active=''
    if [ -d /run/systemd/system ] && command -v systemctl > /dev/null 2>&1; then
      for unit in conduwuit.service matrix-conduwuit.service \
        conduit.service matrix-conduit.service; do
        if systemctl is-active --quiet "$unit" 2>/dev/null; then
          legacy_active="$unit"
        fi
      done
    fi

    if [ -n "$legacy_active" ]; then
      echo "NOTE: $legacy_active is still running, its database was left in place." 1>&2
      echo "NOTE: stop it, then adopt its database with: dpkg-reconfigure tuwunel" 1>&2
    else
      # Adopt the database of a previous conduwuit or conduit installation so
      # an existing server continues transparently and migrates on the next
      # start. The old directory is moved into place, never copied or deleted.
      # The /var/lib/private paths hold the real directory when the old server
      # ran under systemd's DynamicUser=, reaching the public path through a
      # symlink, and an empty leftover directory is cleared rather than left
      # behind.
      #
      # A directory on another filesystem is never moved: mv would silently
      # become a copy of the whole database, and the target may not even have
      # room for it. Comparing devices covers a mount at the directory itself
      # and a mount further up the path alike.
      adopted=''
      state_device=$(stat -c %d /var/lib)
      for legacy in /var/lib/conduwuit /var/lib/private/conduwuit \
        /var/lib/matrix-conduit /var/lib/private/matrix-conduit; do
        if [ -d "$legacy" ] && ! [ -L "$legacy" ]; then
          if [ "$(stat -c %d "$legacy")" != "$state_device" ]; then
            echo "NOTE: $legacy is on another filesystem, mount it at $TUWUNEL_DATABASE_PATH instead" 1>&2
          elif ! [ "$(ls -A "$legacy")" ]; then
            rmdir -v "$legacy"
          else
            # Clear an empty target so the old directory can take its place,
            # unless a filesystem is mounted there, where rmdir would fail and
            # abort the configure step.
            if [ -d "$TUWUNEL_DATABASE_PATH" ] && ! [ -L "$TUWUNEL_DATABASE_PATH" ] \
              && [ "$(stat -c %d "$TUWUNEL_DATABASE_PATH")" = "$state_device" ] \
              && ! [ "$(ls -A "$TUWUNEL_DATABASE_PATH")" ]; then
              rmdir -v "$TUWUNEL_DATABASE_PATH"
            fi
            if [ -e "$TUWUNEL_DATABASE_PATH" ]; then
              echo "NOTE: leaving $legacy in place, $TUWUNEL_DATABASE_PATH already exists" 1>&2
            else
              echo "Adopting the existing database at $legacy" 1>&2
              mv -v "$legacy" "$TUWUNEL_DATABASE_PATH"
              # the public name is the one a configuration carries, even where
              # the database itself lived under /var/lib/private
              adopted="$adopted /var/lib/${legacy##*/}"
              # clean up the stray symlink a previous package version may have
              # left inside the old database directory
              if [ -L "$TUWUNEL_DATABASE_PATH/tuwunel" ] \
                && [ "$(readlink "$TUWUNEL_DATABASE_PATH/tuwunel")" = "$TUWUNEL_DATABASE_PATH" ]; then
                rm -v "$TUWUNEL_DATABASE_PATH/tuwunel"
              fi
            fi
          fi
        fi
      done

      # A configuration that sets database_path may name a previous location,
      # so an installation carrying one keeps whatever symlinks it has. The
      # server reads the packaged file and any the unit's environment names,
      # and a file that cannot be read counts as naming a path, since what it
      # holds cannot be known.
      configured_path=''
      config_files="$TUWUNEL_CONFIG_PATH/tuwunel.toml"
      if command -v systemctl > /dev/null 2>&1; then
        unit_env=$(systemctl show -p Environment --value tuwunel.service 2>/dev/null || true)
        case "$unit_env" in
          *_DATABASE_PATH=*) configured_path='yes' ;;
        esac
        for assignment in $unit_env; do
          case "$assignment" in
            CONDUIT_CONFIG=* | CONDUWUIT_CONFIG=* | TUWUNEL_CONFIG=*)
              config_files="$config_files ${assignment#*=}" ;;
          esac
        done
      fi
      for config_file in $config_files; do
        if ! [ -r "$config_file" ] \
          || grep -qE '^[[:space:]]*database_path[[:space:]]*=' "$config_file"; then
          configured_path='yes'
        fi
      done

      # Symlink a location a database was adopted from, so a configuration
      # ported from the old server keeps reaching it, and clear a symlink left
      # dangling by that adoption or by an uninstalled server. Nowhere else is
      # linked: a previous server's name pointing at the database is one
      # `rm -r` away from deleting it, because a trailing slash makes that
      # command follow the symlink. A symlink an earlier version of this
      # package left where nothing was ever adopted is removed for the same
      # reason, once the configuration is known not to name it.
      for legacy in /var/lib/matrix-conduit /var/lib/conduwuit; do
        if [ -L "$legacy" ] && ! [ -e "$legacy" ]; then
          rm -v "$legacy"
        fi
        case " $adopted " in
          *" $legacy "*)
            if ! [ -e "$legacy" ] && ! [ -L "$legacy" ]; then
              ln -s -v "$TUWUNEL_DATABASE_PATH" "$legacy"
            fi
            continue
            ;;
        esac
        [ -L "$legacy" ] || continue
        if [ "$(readlink -f "$legacy")" != "$(readlink -f "$TUWUNEL_DATABASE_PATH")" ]; then
          echo "NOTE: $legacy points to $(readlink -f "$legacy") and was not adopted" 1>&2
        elif [ -z "$adopted" ] && [ -z "$configured_path" ]; then
          echo "Removing the unused compatibility symlink $legacy" 1>&2
          rm "$legacy"
        fi
      done
    fi

    # Fix up ownership and permissions for the database and the config.
    chown -c tuwunel:tuwunel -R "$TUWUNEL_DATABASE_PATH"
    chown -c tuwunel:tuwunel -R "$TUWUNEL_CONFIG_PATH"

    chmod -c 740 "$TUWUNEL_DATABASE_PATH"

    echo ''
    echo 'Make sure you edit the example config at /etc/tuwunel/tuwunel.toml before starting!'
    echo 'If migrating from another homeserver, port its settings (especially server_name) into that config.'
    echo 'To start the server, run: systemctl start tuwunel.service'
    echo ''

    ;;
esac

# Load the AppArmor profile. It needs both the userspace parser, which this
# package only recommends, and a kernel with AppArmor enabled; with either
# absent the server runs unconfined rather than failing to start. This has to
# precede the debhelper marker below, which carries the restart-on-upgrade
# that would otherwise bring the service back before its profile is in place.
if [ "$1" = "configure" ] && command -v apparmor_parser >/dev/null 2>&1 \
  && [ -d /sys/kernel/security/apparmor ]; then
  apparmor_parser -r -T -W /etc/apparmor.d/usr.sbin.tuwunel || true
fi

# The profile matches resolved paths, so a data directory relocated by a
# drop-in or reached through a symlink is denied even though the unit grants
# it. Name it here, before the restart below brings the service back confined.
if [ "$1" = "configure" ] && [ -d /sys/kernel/security/apparmor ]; then
  uncovered=''
  for path in /var/lib/tuwunel /etc/tuwunel; do
    if [ -L "$path" ]; then
      uncovered="$uncovered $path -> $(readlink -f "$path")"
    fi
  done
  if command -v systemctl > /dev/null 2>&1; then
    for path in $(systemctl show -p ReadWritePaths --value tuwunel.service 2>/dev/null); do
      case "$path" in
        /var/lib/tuwunel | /etc/tuwunel) ;;
        *) uncovered="$uncovered $path" ;;
      esac
    done
  fi
  if [ -n "$uncovered" ]; then
    echo "NOTE: the AppArmor profile does not cover:$uncovered" 1>&2
    echo "NOTE: add it to /etc/apparmor.d/local/usr.sbin.tuwunel and reload the profile," 1>&2
    echo "NOTE: or the confined server is denied that path on its next start." 1>&2
  fi
fi

# cargo-deb expands every occurrence of the marker token, comments included,
# so it is spelled out nowhere else in this script.
#DEBHELPER#

# Enablement is declined for the package as a whole so the socket unit stays
# opt-in, which leaves the service to be enabled here, on first install only so
# an administrator who disabled it keeps that across upgrades.
if [ "$1" = "configure" ] && [ -z "$2" ]; then
  deb-systemd-helper enable tuwunel.service >/dev/null || true
fi
