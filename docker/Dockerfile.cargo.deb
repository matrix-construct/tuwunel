# syntax = docker/dockerfile:1.11-labs

FROM input AS build-deb
ARG rust_target
ARG rust_toolchain
ARG RUSTUP_HOME
ARG CARGO_HOME
ARG CARGO_TARGET
ARG CARGO_TARGET_DIR
ARG cargo_target_profile
ARG cargo_profile
ARG cargo_features
ARG cargo_spec_features
ARG pkg_dir
ARG deb_args=""
ARG sched_policy="--rr"
ARG sched_prio=1

WORKDIR /usr/src/tuwunel
ENV sched_policy=${sched_policy}
ENV sched_prio=${sched_prio}
# The packaging inputs (maintainer scripts, docs) live outside the compile
# subset carried by the input layer, so mount them from the full source.
RUN \
--mount=type=cache,dst=${RUSTUP_HOME}/downloads,sharing=shared \
--mount=type=cache,dst=${CARGO_HOME}/registry,sharing=shared \
--mount=type=cache,dst=${CARGO_HOME}/git,sharing=shared \
--mount=type=bind,from=source,source=/usr/src/tuwunel/debian,target=/usr/src/tuwunel/debian \
--mount=type=bind,from=source,source=/usr/src/tuwunel/README.md,target=/usr/src/tuwunel/README.md \
--mount=type=bind,from=source,source=/usr/src/tuwunel/LICENSE,target=/usr/src/tuwunel/LICENSE \
<<EOF
    set -eux
    for script in debian/postinst debian/postrm; do
        test "$(grep -o DEBHELPER "$script" | wc -l)" -eq 1
        grep -qx '#DEBHELPER#' "$script"
    done
    mkdir -p "${pkg_dir}"
    # Every warning cargo-deb prints is a defect in the package it went on to
    # write anyway, so the log is kept and the build refuses to carry one
    # forward. Capturing it rather than piping keeps cargo-deb's own status.
    log=$(mktemp)
    rustup run ${rust_toolchain} sched_wrap.sh \
        cargo deb \
            --verbose \
            --locked \
            --no-build \
            "${cargo_spec_features}" \
            --features "${cargo_features}" \
            --profile "${cargo_profile}" \
            --target "${CARGO_TARGET}" \
            --manifest-path Cargo.toml \
            --compress-type gz \
            --output "${pkg_dir}" \
            ${deb_args} \
        > "$log" 2>&1 || { cat "$log"; exit 1; }

	cat "$log"
	if sed 's/\x1b\[[0-9;]*m//g' "$log" | grep -q '^warning:'; then
		echo "cargo-deb warned; the package it wrote is wrong" >&2
		exit 1
	fi

	mv ${pkg_dir}/* "${pkg_dir}/tuwunel.deb"
	dpkg --info "${pkg_dir}/tuwunel.deb"
	dpkg --contents "${pkg_dir}/tuwunel.deb"
EOF


FROM scratch AS deb
ARG pkg_dir

COPY --from=input ${pkg_dir}/tuwunel.deb .


FROM input AS deb-install
ARG pkg_dir

WORKDIR ${pkg_dir}
COPY --from=deb . .
# Install into a clean base so apt must resolve the package's dependencies.
RUN <<EOF
	set -eux
	dpkg --info tuwunel.deb
	dpkg --contents tuwunel.deb
	apt-get -y update
	apt-get -y install --no-install-recommends ./tuwunel.deb curl libnss-myhostname
	ldd /usr/sbin/tuwunel | grep -q 'libc\.so\.6'

	# Every program the unit runs comes from the package or from something it
	# depends on, so hold them against the filesystem the install produced.
	sed -nE 's/^Exec[A-Za-z]+=[-+!@]*(\/[^ ]+).*/\1/p' \
		/usr/lib/systemd/system/tuwunel.service | xargs -rt -n1 test -x

	# Both units belong in the directory systemd searches, and the socket is
	# the operator's choice to make, so it arrives installed and unenabled.
	test -f /usr/lib/systemd/system/tuwunel.socket
	test -L /etc/systemd/system/multi-user.target.wants/tuwunel.service
	test ! -e /etc/systemd/system/sockets.target.wants/tuwunel.socket
EOF

# The server test runs in a network namespace of its own. The builder's default
# network is shared by every concurrent step, so two package variants testing
# at once would bind the same loopback port and answer each other's requests.
RUN --network=none <<EOF
	set -eux
	install -d -o tuwunel -g tuwunel /var/lib/tuwunel/package-test
	cat > /var/lib/tuwunel/package-test.toml <<'CONFIG'
[global]
server_name = "package.test"
database_path = "/var/lib/tuwunel/package-test"
address = "127.0.0.1"
port = 8008
allow_registration = true
registration_token = "package-test-token"
db_pool_affinity = false
db_pool_workers = 32

[global.well_known]
client = "https://package.test"

[global.smtp]
connection_uri = "smtp://smtp-package-test.invalid:2525"
sender = "package-test@example.test"
CONFIG

	chown tuwunel:tuwunel /var/lib/tuwunel/package-test.toml
	runuser -u tuwunel env TUWUNEL_CONFIG=/var/lib/tuwunel/package-test.toml /usr/sbin/tuwunel \
		> /var/lib/tuwunel/package-test.log 2>&1 &

	server_pid=$!
	cleanup() {
		status=$?
		kill "$server_pid" 2>/dev/null || true
		wait "$server_pid" || true
		if [ "$status" -ne 0 ]; then
			cat /var/lib/tuwunel/package-test.log
		fi
		exit "$status"
	}

	trap cleanup EXIT
	for attempt in $(seq 1 60); do
		curl -fsS -m 2 http://127.0.0.1:8008/_matrix/client/versions >/dev/null && break
		kill -0 "$server_pid"
		if [ "$attempt" -eq 60 ]; then
			echo "Package test server did not become ready" >&2
			exit 1
		fi
		sleep 1
	done

	# The invalid SMTP hostname must reach delivery and fail without crashing.
	status=$(curl -sS -m 30 -w '%{http_code}' -o /var/lib/tuwunel/package-test-response.json \
		-H 'Content-Type: application/json' \
		-d '{"client_secret":"0123456789abcdef","email":"repro@example.test","send_attempt":1}' \
		http://127.0.0.1:8008/_matrix/client/v3/register/email/requestToken)

	cat /var/lib/tuwunel/package-test-response.json
	test "$status" = 400
	grep -q '"errcode":"M_UNKNOWN"' /var/lib/tuwunel/package-test-response.json
	grep -q 'Failed to send email:' /var/lib/tuwunel/package-test-response.json
	kill -0 "$server_pid"
EOF
